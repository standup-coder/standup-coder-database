  "narrative": {
    "northStar": "拣字成版——中文活字排字房",
    "overview": "整个系统把产品表达为一间排字房：仓库的文档是铸好的活字，访客来拣一副自己的版。视觉世界由四种材料构成——深木（字盘与地面）、铅灰（结构与辅助文字）、纸白（印迹与正文）、朱砂（印泥与唯一强调色）。密度上「盘密文疏」：字盘区格子紧密（8px 间距），阅读区行距宽松（1.95），两者并置形成「工坊 vs 印张」的节奏对比。气质沉、旧、准：深木地上的巨型宋体论题句是每一屏的声部；朱砂红出现即意味着「可取用」或「已盖印」。装饰只有三种：文武双线、内凹浮雕、印章，全部源自印刷工艺本身。",
    "keyCharacteristics": [
      "宋体是唯一的展示声部（活字的直系后代），黑体只做正文",
      "朱砂是唯一强调色，出现第二个强调色即返工",
      "深度全部来自内凹浮雕与双线规，从不使用投影与渐变",
      "等宽字体只承载可核验之物：计数、路径、代码",
      "每个数字都可回溯到仓库实测，诚实声明常驻"
    ],
    "rules": [
      { "name": "朱砂一色 Rule", "body": "朱砂是页面唯一强调色，任何新元素不得引入第二强调色；「是否够醒目」永远靠明度与字重解决，不靠新增色相。", "section": "colors" },
      { "name": "墨不压纸 Rule", "body": "深地面上永远用纸白系文字；次级信息用铅灰系，禁止用中性灰（灰在暖木底上会发脏）。", "section": "colors" },
      { "name": "等宽即证据 Rule", "body": "等宽字体只用于可核验计数、路径与代码；用等宽做风格化装饰是违例。", "section": "typography" },
      { "name": "字重代色 Rule", "body": "强调永远优先用字重（400→600→900）与字号阶梯表达，其次用朱砂；不使用斜体与渐变字。", "section": "typography" },
      { "name": "文武分界 Rule", "body": "章节之间只用文武线分界；用背景色差分界仅限既定的交替章。", "section": "layout" },
      { "name": "雕版不投影 Rule", "body": "深度只来自内凹浮雕与双线规；任何 drop-shadow / blur 光晕 / 渐变都破坏平色印刷的世界。", "section": "elevation" }
    ],
    "dos": [
      "Do 用宋体 900 + 巨型字号作为每屏唯一的视觉声部；论题句一屏一句。",
      "Do 让每个数字带等宽计数与可回溯口径（何处实测、何时截止）。",
      "Do 用内凹浮雕 + 文武线表达全部深度；新组件先问「这个雕版工艺里有没有」。",
      "Do 动效只保留一段主动时刻（拣字落位 + 盖章），必须尊重 prefers-reduced-motion。",
      "Do 图标用 1.5px 描边内联 SVG；汉字只能以「字胚内容」身份出现，不作图标。"
    ],
    "donts": [
      "Don't 引入第二个强调色；朱砂之外的一切颜色必须是木/纸/铅系。",
      "Don't 使用投影、模糊光晕、渐变（文字或面）——平色印刷世界无此工艺。",
      "Don't 使用 kicker/眉题、无信息的大数字卡、emoji 图标（既定世界明文拒绝）。",
      "Don't 把等宽字体用于纯风格化文案；等宽即承诺可核验。",
      "Don't 牌记、印章作为普通装饰复用；它们是收尾与「已拣定」的专属语义。"
    ]
  }
}
